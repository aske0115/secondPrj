{
  "name": "second-prj",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5317 --host",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "native": "npm run build && npx cap sync",
    "ios": "npm run native && npx cap open ios",
    "android": "npm run native && npx cap open android",
    "build:release": "tsc --noEmit && vite build --mode release",
    "native:release": "npm run build:release && npx cap sync"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
