{
  "name": "second-prj",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5317 --host",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "content:check": "vitest run src/content",
    "native": "npm run build && npx cap sync ios",
    "ios": "npm run native && npx cap open ios",
    "build:release": "tsc --noEmit && vite build --mode release",
    "native:release": "npm run build:release && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "lunar-javascript": "^1.7.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
